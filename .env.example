# Copy to .env and fill in. Never commit the filled-in file.

# --- API authentication ---
# Key required on the X-API-KEY header of every clf-api request.
API_KEY=
# Key clf-api and spark-job present when calling the analyzer service.
ANALYZER_API_KEY=
# JWT used for the outbound completion callback.
BEARER_TOKEN=

# --- Downstream services ---
# Endpoint notified when a scan finishes.
COMPLETION_API_URL=https://api.example.com/api/v1

# --- Object storage (MinIO / S3) ---
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=pii-scanner

# --- Postgres ---
POSTGRES_PASSWORD=postgres

# --- Models ---
# Private HuggingFace repo holding the transformer address detector.
HF_ADDRESS_DETECTOR_MODEL=org/address-detector

# --- Build-time secrets (BuildKit secret mounts, never baked into a layer) ---
# Paths to files containing the tokens, not the tokens themselves.
GITHUB_TOKEN_FILE=./github_token.txt
HF_TOKEN_FILE=./hf_token.txt

# --- Licensing (release builds only; dev builds skip validation) ---
KEYGEN_ACCOUNT_ID_DEV=
KEYGEN_ACCOUNT_ID_PROD=
KEYGEN_PRODUCT_ID_DEV=
KEYGEN_PRODUCT_ID_PROD=
KEYGEN_TOKEN_DEV=
KEYGEN_TOKEN_PROD=
KEYGEN_PUBLIC_KEY_DEV=
KEYGEN_PUBLIC_KEY_PROD=
